VIBECODE_APP_KEY=vibe_app_replace_with_server_secret
VIBECODE_API_BASE_URL=https://vibecode.example.com
BITRIX24_ALLOWED_ORIGINS=https://example.bitrix24.com,https://example.bitrix24.ru
APP_PUBLIC_URL=https://dashboard.example.com
NODE_ENV=development
SESSION_CONTEXT_MODE=provisional-headers
# Required when SESSION_CONTEXT_MODE=signed-headers.
SESSION_CONTEXT_HMAC_SECRET=
LOG_LEVEL=info
PORT=3000
